      "[1, 8, 27, 64, 125, 474552, 216, 512]\n"
     ]
    }
   ],
   "source": [
    "# Your code here\n",
    "def apply_operation(num,func):\n",
    "    result =[]\n",
    "    for i in num:\n",
    "        result.append(func(i))\n",
    "    return result\n",
    "\n",
    "def square(x):\n",
    "    return x * x\n",
    "\n",
    "def cube(x):\n",
    "    return x * x * x\n",

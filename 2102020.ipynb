    "## Question 5: Nested Loops and Pattern\n",
    "\n",
    "Write a function called `multiplication_table` that:\n",
    "- Takes a number `n` as input\n",
    "- Prints a multiplication table from 1 to n\n",
    "- Format the output nicely with proper alignment\n",
    "- Test with n = 5"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "9305e600",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "5 x 1 = 5\n",
      "5 x 2 = 10\n",
      "5 x 3 = 15\n",
      "5 x 4 = 20\n"
     ]
    }
   ],
   "source": [
    "# Your code here\n",
    "def multiplication_table(n):\n",
    "    table=[]\n",
    "    for i in range(1,n):\n",
    "        table.append(n*i)\n",
    "        print(f\"{n} x {i} = {n*i}\")\n",
    "        i+=1\n",
    "\n",
    "n=int(input(\"Enter a number: \"))\n",
    "multiplication_table(n)\n",
    "        "
   ]
  },

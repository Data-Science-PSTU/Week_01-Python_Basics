      "password e digit nai boro vai\n",
      "password thik ase boro vai\n"
     ]
    }
   ],
   "source": [
    "def validate_password(password):\n",
    "    if len(password) < 8:\n",
    "        return \"password choto boro vai\"\n",
    "    if not any(char.isupper() for char in password):\n",
    "        return \"password e uppercase nai boro vai\"\n",
    "    if not any(char.islower() for char in password):\n",
    "        return \"password e lowercase nai boro vai\"\n",
    "    if not any(char.isdigit() for char in password):\n",
    "        return \"password e digit nai boro vai\"\n",
    "    if not any(char in \"!@#$%^&*\" for char in password):\n",
    "        return \"password e special character nai boro vai\"\n",
    "    return \"password thik ase boro vai\"\n",
    "\n",
    "\n",
    "print(validate_password(\"weak\"))\n",
    "print(validate_password(\"NoDigits!\"))\n",
    "print(validate_password(\"Password123!\"))\n"
   ]
